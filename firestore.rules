rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only this story's comments are exposed. Other collections remain denied.
    match /works/a-pessoa-do-outro-lado/chapters/{chapter}/paragraphs/{paragraph}/comments/{comment} {
      function validComment() {
        let d = request.resource.data;
        return d.keys().hasAll(['authorName', 'text', 'uid', 'createdAt'])
          && d.keys().hasOnly(['authorName', 'text', 'uid', 'createdAt'])
          && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 60
          && d.authorName.matches('.*[^\\s].*')
          && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
          && d.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && d.uid == request.auth.uid
          && d.createdAt is timestamp && d.createdAt == request.time
          && chapter.matches('[1-9][0-9]{0,3}')
          && paragraph.matches('[a-zA-Z0-9_-]{1,100}');
      }
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 50;
      allow create: if request.auth != null && validComment();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
